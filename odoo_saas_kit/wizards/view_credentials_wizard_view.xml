<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_credentials_wizard_form" model="ir.ui.view">
            <field name="name">saas.credentials.viewer.form</field>
            <field name="model">saas.credentials.viewer</field>
            <field name="arch" type="xml">
                <form string="View Credentials">
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <group invisible="state != 'ask'">
                        <p>
                            Enter the master password of this Hisabflow instance to view the
                            known users and passwords for this database.
                        </p>
                        <field name="master_password" password="True" required="state == 'ask'"/>
                    </group>
                    <group invisible="state != 'result'">
                        <field name="database_label" readonly="1"/>
                    </group>
                    <field name="line_ids" invisible="state != 'result'" readonly="1">
                        <list editable="false" create="false" delete="false">
                            <field name="login"/>
                            <field name="password"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <p class="text-muted" invisible="state != 'result'">
                        Only the SaaS Kit's own default admin account (id 2) has a known
                        password, shown above. Any other user - or that same admin if the
                        client has since completed their own password reset - has a real
                        password that cannot be recovered; Odoo only stores an irreversible
                        hash.
                    </p>
                    <footer>
                        <button string="Show Credentials" name="action_validate" type="object" class="btn-primary" invisible="state != 'ask'"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_credentials_wizard_plan" model="ir.actions.act_window">
            <field name="name">View Credentials</field>
            <field name="res_model">saas.credentials.viewer</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_credentials_wizard_form"/>
            <field name="context">{'default_res_model': 'saas.plan', 'default_res_id': active_id}</field>
            <field name="target">new</field>
        </record>

        <record id="action_view_credentials_wizard_client" model="ir.actions.act_window">
            <field name="name">View Credentials</field>
            <field name="res_model">saas.credentials.viewer</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_credentials_wizard_form"/>
            <field name="context">{'default_res_model': 'saas.client', 'default_res_id': active_id}</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
