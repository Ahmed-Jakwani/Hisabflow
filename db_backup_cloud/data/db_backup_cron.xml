<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default configuration parameters -->
        <record id="dbk_param_backup_root" model="ir.config_parameter">
            <field name="key">db_backup_cloud.backup_root</field>
            <field name="value">/opt/odoo19/Backups</field>
        </record>
        <record id="dbk_param_default_keep" model="ir.config_parameter">
            <field name="key">db_backup_cloud.default_keep</field>
            <field name="value">7</field>
        </record>
        <record id="dbk_param_schedule_enabled" model="ir.config_parameter">
            <field name="key">db_backup_cloud.schedule_enabled</field>
            <field name="value">False</field>
        </record>
        <record id="dbk_param_saas_data_root" model="ir.config_parameter">
            <field name="key">db_backup_cloud.saas_data_root</field>
            <field name="value">/opt/odoo19/Odoo-SAAS-Data</field>
        </record>
        <record id="dbk_param_template_container" model="ir.config_parameter">
            <field name="key">db_backup_cloud.template_container</field>
            <field name="value">odoo19_template_cont</field>
        </record>

    </data>

    <!-- Not noupdate: a fix to the cron definition must reach existing
         installs on upgrade. -->
    <data>
        <!-- Runs daily; each target is backed up only when its own frequency
             says it is due. Gated by the 'schedule_enabled' setting. -->
        <record id="ir_cron_db_backup" model="ir.cron">
            <field name="name">Database Backup: Scheduled</field>
            <field name="model_id" ref="model_db_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_backup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
